{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        },
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "checkout.html",
            "use": "@vercel/static"
        },
        {
            "src": "hellocuve_full.html",
            "use": "@vercel/static"
        },
        {
            "src": "public/**/*",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "*.js",
            "use": "@vercel/static",
            "config": {
                "include": [
                    "main.js"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/success",
            "dest": "server.js"
        },
        {
            "src": "/fail",
            "dest": "server.js"
        },
        {
            "src": "/(.*)",
            "dest": "$1"
        }
    ]
}